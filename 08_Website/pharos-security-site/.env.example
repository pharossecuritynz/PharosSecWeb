# Exposure Snapshot — environment variables
# Copy this file to .env.local and fill in real values. .env.local is
# gitignored; never commit real keys. See docs/EXTERNAL_PROVIDERS.md for
# the cost/licensing detail behind each of these before enabling any of
# them for real.

# Shodan — previously-observed internet-facing services (Internet Exposure
# domain). Requires a PAID Shodan plan for any commercial use; the free
# InternetDB tier is explicitly non-commercial-only. Leave unset to
# gracefully skip this check (reports "not checked", never fails a scan).
SHODAN_API_KEY=

# Censys — same category as Shodan, merged into the same Internet Exposure
# finding. Targets the current Platform API v3, which requires BOTH of the
# variables below — a Personal Access Token is not sufficient on its own.
CENSYS_API_KEY=
CENSYS_ORGANIZATION_ID=

# Have I Been Pwned — domain-wide credential exposure (Level 2, verified
# domains only — not built yet, see EXPOSURE_SNAPSHOT_ROADMAP.md Milestone
# 6/7). No free tier exists for domain search.
HIBP_API_KEY=

# Resend — "email me this report". Required for the email API route to
# work; without it, that route returns a clear 503, never a silent failure.
RESEND_API_KEY=

# The verified sending address for report emails. pharos.security.nz is not
# a registered domain yet (see decisions-required.md question 5), and
# Resend requires a verified sending domain, so this defaults to Resend's
# own unverified testing address if left unset. Set this once a real
# domain is registered and verified with Resend.
RESEND_FROM_ADDRESS=
